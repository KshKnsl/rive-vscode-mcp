{
  "name": "rive-vscode-mcp",
  "displayName": "Rive VS Code MCP",
  "description": "Preview Rive assets in VS Code and expose file insights to AI agents through MCP.",
  "version": "0.0.1",
  "publisher": "kushkansal",
  "author": "Kush Kansal",
  "license": "MIT",
  "engines": {
    "vscode": "^1.144.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "rive",
    "animation",
    "preview",
    "artboard",
    "state-machine"
  ],
  "icon": "icon.png",
  "main": "./out/extension.js",
  "activationEvents": [
    "onCustomEditor:rive-vscode-mcp.rivePreview"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "rive-vscode-mcp.rivePreview",
        "displayName": "Rive VS Code MCP",
        "selector": [
          {
            "filenamePattern": "*.riv"
          }
        ]
      }
    ],
    "languages": [
      {
        "id": "rive",
        "extensions": [
          ".riv"
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "build:css": "node ./scripts/build-css.mjs",
    "compile": "npm run build:css && tsc -p ./",
    "watch:css": "node ./scripts/build-css.mjs --watch",
    "watch": "tsc -w -p ./",
    "mcp": "node ./mcp.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@rive-app/canvas": "^2.49.0",
    "@rive-app/canvas-advanced": "^2.49.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.13",
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.144.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.3"
  }
}
